PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_db?schema=public
JWT_SECRET=it-job-demo-jwt-secret
JWT_REFRESH_SECRET=it-job-demo-jwt-refresh-secret
JWT_EXPIRATION_TIME=120s
JWT_REFRESH_EXPIRATION_TIME=7d
IMAGEKIT_PUBLIC_KEY=replace-with-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=replace-with-imagekit-private-key
IMAGEKIT_FOLDER=/captures
# Optional: only needed if you later want SDK URL generation with your real CDN endpoint
IMAGEKIT_URL_ENDPOINT=
KAFKA_CLIENT_ID=identity-service
KAFKA_GROUP_ID=identity-service-group
KAFKA_BROKERS=localhost:29092
FRONTEND_LOGIN_URL=http://localhost:3000/login
OBSERVABILITY_LOG_FILE=../../runtime-logs/identity-service.log
