pipeline {
  agent {
    label 'linux'
  }

  environment {
    SERVICE_NAME = 'identity-service'
    SERVICE_DIR = 'services/identity-service'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install Dependencies') {
      steps {
        dir("${SERVICE_DIR}") {
          sh 'npm ci'
        }
      }
    }

    stage('Run Tests') {
      steps {
        dir("${SERVICE_DIR}") {
          sh 'npm run test'
        }
      }
    }

    stage('Build Application') {
      steps {
        dir("${SERVICE_DIR}") {
          sh 'npm run build'
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        dir("${SERVICE_DIR}") {
          sh 'docker build -t ${SERVICE_NAME}:${BUILD_NUMBER} -t ${SERVICE_NAME}:latest .'
        }
      }
    }
  }
}
